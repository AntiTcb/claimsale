{
	"name": "@claimsale/engine",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"dev": "wrangler dev --port 8788",
		"cf-typegen": "wrangler types --strict-vars=false src/worker-configuration.d.ts",
		"typecheck": "tsc --noEmit && tsc -p test --noEmit",
		"test": "vitest run --project engine && vitest run --project engine-d1",
		"db:migrate:local": "wrangler d1 migrations apply DB --local"
	},
	"dependencies": {
		"@claimsale/core": "workspace:*",
		"@claimsale/db": "workspace:*",
		"@claimsale/emails": "workspace:*",
		"@claimsale/imagehash": "workspace:*",
		"@claimsale/observability": "workspace:*",
		"@jsquash/jpeg": "catalog:",
		"@jsquash/png": "catalog:",
		"@jsquash/webp": "catalog:",
		"effect": "catalog:",
		"uuidv7": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "catalog:workers-test",
		"typescript": "catalog:",
		"vitest": "catalog:workers-test",
		"wrangler": "catalog:"
	}
}
