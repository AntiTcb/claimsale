{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Top level = local development and tests. Deployed environments are under "env".
	"name": "claimsale-engine",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"observability": {
		"logs": { "enabled": true },
		"traces": { "enabled": true },
	},
	"vars": {
		"APP_ENV": "local",
		"VERSION": "dev",
		"MAIL_FROM": "no-reply@notify.claimsale.net",
		// Sentry DSN (public by design); empty disables error reports (TECH_STACK S38).
		"SENTRY_DSN": "",
		// TCG catalog ingestion (TECH_STACK S32). Tests stub fetch and serve fixtures.
		"TCGCSV_BASE_URL": "https://tcgcsv.com",
		"CATALOG_GROUPS_PER_RUN": "300",
	},
	// Cloudflare Email Service (TECH_STACK S28). Simulated by `wrangler dev` and tests.
	"send_email": [{ "name": "EMAIL" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "claimsale-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "../../packages/db/migrations",
		},
	],
	// Seller photos (the web Worker's bucket): the photo verify job reads uploads (S33).
	"r2_buckets": [{ "binding": "IMAGES", "bucket_name": "claimsale-images-local" }],
	"durable_objects": {
		"bindings": [{ "name": "SALE_ENGINE", "class_name": "SaleEngine" }],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["SaleEngine"] }],
	"queues": {
		"producers": [{ "binding": "NOTIFICATIONS", "queue": "claimsale-notifications-local" }],
		"consumers": [{ "queue": "claimsale-notifications-local", "max_batch_size": 25, "max_retries": 5 }],
	},
	// Timer sweep, and the catalog ingestion (CATALOG_CRON in src/catalog/index.ts).
	"triggers": { "crons": ["*/5 * * * *", "15 0-2,21-23 * * *"] },
	"env": {
		"staging": {
			"name": "claimsale-engine-staging",
			"vars": {
				"APP_ENV": "staging",
				"VERSION": "set-by-ci",
				"MAIL_FROM": "no-reply@notify.claimsale.net",
				"SENTRY_DSN": "",
				"TCGCSV_BASE_URL": "https://tcgcsv.com",
				"CATALOG_GROUPS_PER_RUN": "300",
			},
			"send_email": [{ "name": "EMAIL" }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "claimsale-staging",
					"database_id": "e4d69871-204b-4634-9c23-069b3374d585",
					"migrations_dir": "../../packages/db/migrations",
				},
			],
			"r2_buckets": [{ "binding": "IMAGES", "bucket_name": "claimsale-images-staging" }],
			"durable_objects": {
				"bindings": [{ "name": "SALE_ENGINE", "class_name": "SaleEngine" }],
			},
			"queues": {
				"producers": [{ "binding": "NOTIFICATIONS", "queue": "claimsale-notifications-staging" }],
				"consumers": [{ "queue": "claimsale-notifications-staging", "max_batch_size": 25, "max_retries": 5 }],
			},
			// No catalog cron: staging ingests on demand (ingestCatalog RPC), sparing TCGCSV's request budget.
			"triggers": { "crons": ["*/5 * * * *"] },
		},
		"production": {
			"name": "claimsale-engine",
			"vars": {
				"APP_ENV": "production",
				"VERSION": "set-by-ci",
				"MAIL_FROM": "no-reply@notify.claimsale.net",
				"SENTRY_DSN": "",
				"TCGCSV_BASE_URL": "https://tcgcsv.com",
				"CATALOG_GROUPS_PER_RUN": "300",
			},
			"send_email": [{ "name": "EMAIL" }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "claimsale-production",
					"database_id": "5506c6e8-0aa3-4bea-953e-f5a82995717c",
					"migrations_dir": "../../packages/db/migrations",
				},
			],
			"r2_buckets": [{ "binding": "IMAGES", "bucket_name": "claimsale-images" }],
			"durable_objects": {
				"bindings": [{ "name": "SALE_ENGINE", "class_name": "SaleEngine" }],
			},
			"queues": {
				"producers": [{ "binding": "NOTIFICATIONS", "queue": "claimsale-notifications" }],
				"consumers": [{ "queue": "claimsale-notifications", "max_batch_size": 25, "max_retries": 5 }],
			},
			// Production alone runs the catalog cron (TCGCSV asks for < 10,000 requests a day).
			"triggers": { "crons": ["*/5 * * * *", "15 0-2,21-23 * * *"] },
		},
	},
}
