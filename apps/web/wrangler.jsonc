{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Top level = local development and tests. Deployed environments are under "env".
	// "main" must be the adapter's output path: adapter-cloudflare writes the Worker there.
	"name": "claimsale-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	// Run the Worker next to its D1 database, not next to the visitor (TECH_STACK S42). Every
	// page load makes several sequential D1 queries; from a far colo each one is a long round
	// trip (about 1 s per request from Tokyo against ~0.1 s from Virginia). D1 databases are
	// created with the "enam" location hint (scripts/cf-resources.sh); aws:us-east-1 sits there.
	// Static assets are still served from the visitor's nearest colo. Local dev ignores this.
	"placement": { "region": "aws:us-east-1" },
	"observability": {
		"logs": { "enabled": true },
		"traces": { "enabled": true },
	},
	"vars": {
		"APP_ENV": "local",
		"VERSION": "dev",
		// Sentry DSN (public by design); empty disables error reports (TECH_STACK S38).
		"SENTRY_DSN": "",
		"MAIL_FROM": "no-reply@notify.claimsale.net",
		// "capture" writes email to the email_outbox table (E2E reads it); "cloudflare" sends it.
		// Never "capture" where the data is shared with real users (staging, its Previews, production).
		"MAILER": "capture",
		// Turnstile on sign-up (S41). Cloudflare's "always passes" test key here and in PR pairs.
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
	},
	// Better Auth signing secret (.dev.vars locally; GitHub Environment secret in CI).
	// Optional, not required: DISCORD_CLIENT_ID and DISCORD_CLIENT_SECRET turn on Discord sign-in;
	// TURNSTILE_SECRET_KEY pairs with a real TURNSTILE_SITE_KEY (the test site key falls back to the
	// test secret; a real site key without its secret turns email sign-up off).
	"secrets": { "required": ["BETTER_AUTH_SECRET"] },
	"services": [{ "binding": "ENGINE", "service": "claimsale-engine" }],
	// The same database as the engine (TECH_STACK §2): sessions and users live here.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "claimsale-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "../../packages/db/migrations",
		},
	],
	"send_email": [{ "name": "EMAIL" }],
	// Seller photos (PLAN §5 "Images"). Private: served only through /api/images/[id],
	// which checks sale access (SM-2-private-images). Local dev simulates it.
	"r2_buckets": [{ "binding": "IMAGES", "bucket_name": "claimsale-images-local" }],
	"env": {
		"staging": {
			"name": "claimsale-web-staging",
			"placement": { "region": "aws:us-east-1" },
			"vars": {
				"APP_ENV": "staging",
				"VERSION": "set-by-ci",
				"SENTRY_DSN": "",
				"MAIL_FROM": "no-reply@notify.claimsale.net",
				"MAILER": "cloudflare",
				// Test key until the staging widget exists (owner step, TECH_STACK §11); staging is
				// behind Access, so bots can't reach its sign-up meanwhile.
				"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
			},
			"secrets": { "required": ["BETTER_AUTH_SECRET"] },
			"services": [{ "binding": "ENGINE", "service": "claimsale-engine-staging" }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "claimsale-staging",
					"database_id": "e4d69871-204b-4634-9c23-069b3374d585",
					"migrations_dir": "../../packages/db/migrations",
				},
			],
			"send_email": [{ "name": "EMAIL" }],
			"r2_buckets": [{ "binding": "IMAGES", "bucket_name": "claimsale-images-staging" }],
			// Worker Previews (TECH_STACK S37): `wrangler preview --env staging` creates a
			// Preview of claimsale-web-staging. Previews inherit nothing from the settings
			// above, and a Preview's service binding reaches the bound Worker's deployed
			// version, so web Previews run against the staging engine and its data.
			// Production (top level and env.production) has no previews block on purpose.
			"previews": {
				// Previews inherit nothing, so the placement too (staging's database).
				"placement": { "region": "aws:us-east-1" },
				// Staging data, so real email, never the capture outbox.
				"vars": {
					"APP_ENV": "preview",
					"VERSION": "set-by-ci",
					"SENTRY_DSN": "",
					"MAIL_FROM": "no-reply@notify.claimsale.net",
					"MAILER": "cloudflare",
					"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
				},
				"secrets": { "required": ["BETTER_AUTH_SECRET"] },
				"services": [{ "binding": "ENGINE", "service": "claimsale-engine-staging" }],
				"d1_databases": [
					{
						"binding": "DB",
						"database_name": "claimsale-staging",
						"database_id": "e4d69871-204b-4634-9c23-069b3374d585",
						"migrations_dir": "../../packages/db/migrations",
					},
				],
				"send_email": [{ "name": "EMAIL" }],
				// Staging data, so staging's photos.
				"r2_buckets": [{ "binding": "IMAGES", "bucket_name": "claimsale-images-staging" }],
			},
		},
		"production": {
			"name": "claimsale-web",
			"workers_dev": false,
			"placement": { "region": "aws:us-east-1" },
			"vars": {
				"APP_ENV": "production",
				"VERSION": "set-by-ci",
				"SENTRY_DSN": "",
				"MAIL_FROM": "no-reply@notify.claimsale.net",
				"MAILER": "cloudflare",
				// The production widget's site key (owner step). Empty turns email sign-up off.
				"TURNSTILE_SITE_KEY": "",
			},
			"secrets": { "required": ["BETTER_AUTH_SECRET"] },
			"services": [{ "binding": "ENGINE", "service": "claimsale-engine" }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "claimsale-production",
					"database_id": "5506c6e8-0aa3-4bea-953e-f5a82995717c",
					"migrations_dir": "../../packages/db/migrations",
				},
			],
			"send_email": [{ "name": "EMAIL" }],
			"r2_buckets": [{ "binding": "IMAGES", "bucket_name": "claimsale-images" }],
			// Custom domain (claimsale.net) is added once the domain is registered in the account.
		},
	},
}
