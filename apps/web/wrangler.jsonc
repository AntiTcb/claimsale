{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Top level = local development and tests. Deployed environments are under "env".
	// "main" must be the adapter's output path: adapter-cloudflare writes the Worker there.
	"name": "claimsale-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"observability": {
		"logs": { "enabled": true },
		"traces": { "enabled": true },
	},
	"vars": {
		"APP_ENV": "local",
		"VERSION": "dev",
		// Sentry DSN (public by design); empty disables error reports (TECH_STACK S38).
		"SENTRY_DSN": "",
	},
	"services": [{ "binding": "ENGINE", "service": "claimsale-engine" }],
	"env": {
		"staging": {
			"name": "claimsale-web-staging",
			"vars": { "APP_ENV": "staging", "VERSION": "set-by-ci", "SENTRY_DSN": "" },
			"services": [{ "binding": "ENGINE", "service": "claimsale-engine-staging" }],
			// Worker Previews (TECH_STACK S37): `wrangler preview --env staging` creates a
			// Preview of claimsale-web-staging. Previews inherit nothing from the settings
			// above, and a Preview's service binding reaches the bound Worker's deployed
			// version, so web Previews run against the staging engine and its data.
			// Production (top level and env.production) has no previews block on purpose.
			"previews": {
				"vars": { "APP_ENV": "preview", "VERSION": "set-by-ci", "SENTRY_DSN": "" },
				"services": [{ "binding": "ENGINE", "service": "claimsale-engine-staging" }],
			},
		},
		"production": {
			"name": "claimsale-web",
			"workers_dev": false,
			"vars": { "APP_ENV": "production", "VERSION": "set-by-ci", "SENTRY_DSN": "" },
			"services": [{ "binding": "ENGINE", "service": "claimsale-engine" }],
			// Custom domain (claimsale.net) is added once the domain is registered in the account.
		},
	},
}
